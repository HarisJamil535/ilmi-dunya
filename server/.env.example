# Email delivery for branded student welcome and password reset messages
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ilmidunya
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_JWT_EXPIRES_IN=8h
JWT_EXPIRES_IN=7d
SITE_URL=http://localhost:5000
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5000
TRUST_PROXY_HOPS=0
MONGO_MAX_POOL_SIZE=20
# Optional: only needed when the system DNS resolver cannot resolve Atlas SRV records.
# Leave blank to use system DNS. Example: 1.1.1.1,8.8.8.8
MONGO_DNS_SERVERS=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
MAIL_FROM=IlmiDunya <no-reply@ilmidunya.pk>

# Recommended on Render Free because SMTP ports are blocked there.
# Create a free Resend API key and set MAIL_FROM to an allowed sender.
RESEND_API_KEY=
