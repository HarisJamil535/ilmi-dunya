# Email delivery for branded student welcome and password reset messages
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ilmidunya
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_JWT_EXPIRES_IN=8h
JWT_EXPIRES_IN=7d
SITE_URL=http://localhost:5000
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5000
TRUST_PROXY_HOPS=0
MONGO_MAX_POOL_SIZE=20
# Optional: only needed when the system DNS resolver cannot resolve Atlas SRV records.
# Leave blank to use system DNS. Example: 1.1.1.1,8.8.8.8
MONGO_DNS_SERVERS=
# Email for sign-up and password codes. With a Hostinger mailbox (hPanel > Emails), use:
#   SMTP_HOST=smtp.hostinger.com  SMTP_PORT=465  SMTP_SECURE=true
#   SMTP_USER=the full mailbox address, SMTP_PASS=that mailbox's password (no quotes)
#   MAIL_FROM=IlmiDunya <the same mailbox address>   (another address is rejected or sent to spam)
# Admin > Students > Email delivery checks these settings and sends a test email.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@ilmidunya.org
SMTP_PASS=your-mailbox-password
MAIL_FROM=IlmiDunya <info@ilmidunya.org>

# Recommended on Render Free because SMTP ports are blocked there.
# Create a free Resend API key and set MAIL_FROM to an allowed sender.
RESEND_API_KEY=

# Optional student authentication providers. Set these in Render's environment, not in source control.
# Add the public web client ID and authorized site origin in Google Cloud Console.
GOOGLE_CLIENT_ID=

# Twilio Verify WhatsApp OTP (create a Verify Service and enable WhatsApp).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# One-time super admin creation: npm --prefix server run create-super-admin
# Set these only while running the command, then remove the password.
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Shown to blocked students in the "You are blocked" message (both optional).
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=
